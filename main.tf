module "pypi" {
  source  = "frach/serverless-pypi-index/aws"
  version = "0.4.0"

  name                                         = var.name
  tags                                         = var.tags
  cloudfront_enabled                           = var.cloudfront_enabled
  cloudfront_http_version                      = var.cloudfront_http_version
  cloudfront_price_class                       = var.cloudfront_price_class
  cloudfront_ttl_min                           = var.cloudfront_ttl_min
  cloudfront_ttl_default                       = var.cloudfront_ttl_default
  cloudfront_ttl_max                           = var.cloudfront_ttl_max
  cloudfront_aliases                           = var.cloudfront_aliases
  cloudfront_acm_certificate_arn               = var.cloudfront_acm_certificate_arn
  cloudfront_minimum_protocol_version          = var.cloudfront_minimum_protocol_version
  cloudfront_response_headers_policy_id        = var.cloudfront_response_headers_policy_id
  cloudfront_web_acl_id                        = var.cloudfront_web_acl_id
  cloudfront_logging_bucket                    = var.cloudfront_logging_bucket
  cloudfront_logging_prefix                    = var.cloudfront_logging_prefix
  route53_zone_id                              = var.route53_zone_id
  log_retention_in_days                        = var.log_retention_in_days
  auth_enabled                                 = var.auth_enabled
  auth_credentials                             = var.auth_credentials
  auth_realm                                   = var.auth_realm
  auth_cache_ttl                               = var.auth_cache_ttl
  auth_secret_recovery_window_in_days          = var.auth_secret_recovery_window_in_days
  upstream_enabled                             = var.upstream_enabled
  upstream_index_url                           = var.upstream_index_url
  upstream_cooldown_days                       = var.upstream_cooldown_days
  upstream_cooldown_exclude                    = var.upstream_cooldown_exclude
  upload_enabled                               = var.upload_enabled
  upload_credentials                           = var.upload_credentials
  s3_create_bucket                             = var.s3_create_bucket
  s3_bucket_name                               = var.s3_bucket_name
  s3_force_destroy                             = var.s3_force_destroy
  s3_acceleration_status                       = var.s3_acceleration_status
  s3_request_payer                             = var.s3_request_payer
  s3_acl                                       = var.s3_acl
  s3_admin_principal_arns                      = var.s3_admin_principal_arns
  s3_attach_deny_insecure_transport_policy     = var.s3_attach_deny_insecure_transport_policy
  s3_attach_require_latest_tls_policy          = var.s3_attach_require_latest_tls_policy
  s3_attach_deny_incorrect_encryption_headers  = var.s3_attach_deny_incorrect_encryption_headers
  s3_attach_deny_incorrect_kms_key_sse         = var.s3_attach_deny_incorrect_kms_key_sse
  s3_attach_deny_unencrypted_object_uploads    = var.s3_attach_deny_unencrypted_object_uploads
  s3_attach_deny_ssec_encrypted_object_uploads = var.s3_attach_deny_ssec_encrypted_object_uploads
  s3_block_public_acls                         = var.s3_block_public_acls
  s3_block_public_policy                       = var.s3_block_public_policy
  s3_ignore_public_acls                        = var.s3_ignore_public_acls
  s3_restrict_public_buckets                   = var.s3_restrict_public_buckets
  s3_control_object_ownership                  = var.s3_control_object_ownership
  s3_object_ownership                          = var.s3_object_ownership
  s3_versioning                                = var.s3_versioning
}
